{
  "name": "@retrofit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin Hono server: routes, SQLite storage, enrichment, Gemini layer.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts"
  },
  "dependencies": {
    "@google/genai": "1.52.0",
    "@hono/node-server": "1.19.17",
    "@retrofit/contracts": "*",
    "@retrofit/engine": "*",
    "@retrofit/federato": "*",
    "@sentry/node": "10.75.0",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "sharp": "0.34.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
