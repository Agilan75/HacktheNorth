# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=

# Federato. Leave FEDERATO_BASE_URL empty to use the Mock adapter.
FEDERATO_BASE_URL=
# Auth option 1: static bearer key
FEDERATO_API_KEY=
# Auth option 2: OAuth client credentials
FEDERATO_TOKEN_URL=
FEDERATO_AUDIENCE=
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
# Optional path overrides (defaults shown)
FEDERATO_SCHEMA_PATH=/schema
FEDERATO_SUBMISSIONS_PATH=/submissions
FEDERATO_GUIDELINES_PATH=/guidelines
FEDERATO_GLOSSARY_PATH=/glossary

# Optional
GOOGLE_PLACES_API_KEY=

PORT=3000
# Mobile: set to your tunnel or LAN URL
EXPO_PUBLIC_API_URL=http://localhost:3000
