# Copy to .env and fill in. .env is git-ignored and is never printed, copied into
# a source file, or committed. Every variable below is read in exactly one place:
# apps/api/src/env.ts (PRD §7.4, §8).

# --- Anthropic (PRD §9) ---
# Claude: EVERY LLM call, text and vision (observe, verify-fix, extraction,
# drafts, narration, schema-assist, relate, the verification second opinion).
# Unset -> the API still starts and serves the seeded sweep.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to one workspace (Console -> Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Legacy. The Gemini provider is still in the tree but wired to nothing; set this
# only to run apps/api/src/llm/gemini.live.test.ts.
GEMINI_API_KEY=

# --- Federato (PRD §7.4) ---
# Leave FEDERATO_BASE_URL empty to run MockFederatoAdapter over the saved
# snapshot. A loud banner at startup says which adapter is active.
FEDERATO_BASE_URL=
FEDERATO_TOKEN_URL=
FEDERATO_AUDIENCE=
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=

# --- Server (PRD §8) ---
PORT=3000

# --- Mobile (PRD §11) ---
# Set to your tunnel or LAN URL so Expo Go can reach the API.
EXPO_PUBLIC_API_URL=http://localhost:3000
